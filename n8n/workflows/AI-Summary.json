    {
      "parameters": {
        "jsCode": "let emails = [];\n\nif (Array.isArray(items[0].json.data)) {\n  const firstData = items[0].json.data[0];\n  if (Array.isArray(firstData.emails)) {\n    emails = firstData.emails;\n  }\n}\n\nconst prompt =\n  `Tu es un assistant qui résume des emails pour un manager.\\n` +\n  `Voici les emails reçus aujourd'hui :\\n\\n` +\n  emails\n    .map(\n      e =>\n        `De: ${e.sender}, Sujet: ${e.subject}, Extrait: ${e.summary}`\n    )\n    .join('\\n') +\n  `\\n\\nRédige un résumé clair, structuré, en français, en mettant en avant les points importants et les actions éventuelles à retenir.`;\n\nreturn [{ json: { prompt } }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        624,
        0
      ],
