              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"llama-3.1-8b-instant\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"Tu es un assistant qui résume des emails.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"{{ $json.prompt.replace(/\\n/g,'\\\\n').replace(/\"/g,'\\\\\"') }}\"\n    }\n  ],\n  \"temperature\": 0.7,\n  \"max_tokens\": 512\n}\n",
        "options": {}
      },
