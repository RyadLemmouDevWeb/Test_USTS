        "mode": "runOnceForEachItem",
        "jsCode": "const emailData = $json.payload || $json;\nconst snippet = $json.snippet || \"\";\nconst bodyData = emailData.body?.data || \"\";\n\n\nlet emailContent = snippet;\nif (bodyData) {\n  try {\n    emailContent = Buffer.from(bodyData, 'base64').toString('utf-8');\n  } catch (e) {\n    emailContent = snippet;\n  }\n}\n\nconst from = $json.from || \"\";\nconst subject = $json.subject || \"\";\n\nconst context = $json[\"context\"] || \"\";\nconst prompt = `Tu es un assistant qui répond aux emails pour un manager.\n\nEmail reçu de ${from}:\nSujet: ${subject}\nContenu: ${emailContent}\n\n${context ? \"Contexte : \" + context + \"\\n\\n\" : \"\"}Rédige une réponse professionnelle, claire et concise en français.`;\n\nreturn {\n  to: from,\n  subject: subject,\n  messageId: $json.id,\n  prompt: prompt\n};\n\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
