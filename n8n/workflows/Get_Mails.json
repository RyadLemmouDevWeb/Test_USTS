    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nfunction getHeader(headers, name) {\n  if (!headers) return undefined;\n  if (Array.isArray(headers)) {\n    const found = headers.find(h => h.name?.toLowerCase() === name.toLowerCase());\n    return found ? found.value : undefined;\n  }\n  if (typeof headers === 'object') {\n    return headers[name] || headers[name.toLowerCase()];\n  }\n  return undefined;\n}\n\nconst transformedEmails = items.map((item, index) => {\n  const email = item.json;\n  let emailData = email;\n  if (email.payload) {\n    emailData = email.payload;\n  }\n\n  const headers = emailData.headers || email.headers || email.payload?.headers;\n\n  return {\n    id: email.id || emailData.id || `email_${index}`,\n    sender: \n      email.From ||\n      email.from ||\n      getHeader(headers, 'From') ||\n      'sender inconnu',\n    to: \n      email.To ||\n      email.to ||\n      getHeader(headers, 'To') ||\n      'destinataire inconnu',\n    subject: \n      email.Subject ||\n      email.subject ||\n      getHeader(headers, 'Subject') ||\n      'No Subject',\n    date: \n      email.date ||\n      email.internalDate ||\n      getHeader(headers, 'Date') ||\n      new Date().toISOString(),\n    summary: \n      email.snippet ||\n      email.body ||\n      email.text ||\n      (emailData.body && emailData.body.data) ||\n      'No content available',\n    priority: 'medium',\n    read: email.read !== undefined ? email.read : true,\n    content: \n      email.body ||\n      email.snippet ||\n      email.text ||\n      (emailData.body && emailData.body.data) ||\n      'No content'\n  };\n});\n\nreturn [{\n  json: {\n    emails: transformedEmails,\n    metadata: {\n      totalCount: transformedEmails.length,\n      fetchedAt: new Date().toISOString(),\n      source: 'gmail-api'\n    }\n  }\n}];"
      },
